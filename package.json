{
  "name": "refinement",
  "author": "Andrew Whaley",
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azw413/pebble-mdr-watchface.git"
  },
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.1.0",
    "pebble-fctx": "^1.6.5"
  },
  "devDependencies": {
    "pebble-fctx-compiler": "^1.2.2"
  },
  "overrides": {
    "colors": "1.4.0"
  },
  "scripts": {
    "fonts": "python3 tools/build_fonts.py"
  },
  "pebble": {
    "displayName": "Refinement",
    "uuid": "3e7acad2-a7b4-43c9-aaf4-1c3ee9718875",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "basalt",
      "emery",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "Layout",
      "Colour",
      "Interval"
    ],
    "resources": {
      "media": [
        {
          "type": "raw",
          "name": "FFONT_MICHROMA",
          "file": "fonts/michroma.ffont"
        },
        {
          "type": "font",
          "name": "FONT_SILKSCREEN_8",
          "file": "fonts/Silkscreen-Regular.ttf",
          "characterRegex": "[0-9% ]",
          "targetPlatforms": [
            "basalt"
          ]
        },
        {
          "type": "font",
          "name": "FONT_SILKSCREEN_16",
          "file": "fonts/Silkscreen-Regular.ttf",
          "characterRegex": "[0-9% ]",
          "targetPlatforms": [
            "emery",
            "gabbro"
          ]
        }
      ]
    },
    "capabilities": [
      "configurable"
    ]
  }
}
